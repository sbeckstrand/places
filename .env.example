# Copy this file to .env and fill in values before running `docker compose up`.

# --- Database ---
# Used by tools run on the host (e.g. `pnpm exec prisma studio`).
# Inside the app container, docker-compose.yml overrides this to point at
# the `postgres` service hostname instead of localhost.
DATABASE_URL="postgresql://foodie:foodie@localhost:5433/foodie?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Local dev user, created by `prisma/seed.ts` on container startup.
DEV_USER_EMAIL="dev@example.com"
DEV_USER_PASSWORD="devpassword123"

# Google OAuth — leave blank during dev. The Google sign-in button only
# appears once both of these are set (see src/lib/auth.ts).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Places API — powers the "Import from Google Maps" button on the
# entry form (title/address/website/description from a share link). Leave
# blank to disable; see README for how to get a key.
GOOGLE_PLACES_API_KEY=""

# --- Object storage (MinIO in dev, S3-compatible in prod) ---
# Used by tools run on the host. Inside the app container, docker-compose.yml
# overrides these to point at the `minio` service hostname.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="foodie-photos"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
